<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>TapScore</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- The web client's type pair: Fraunces (display serif) + Archivo (UI
	     sans), loaded from static TTFs in TapScore/Resources/Fonts/ rather
	     than the variable fonts the web pulls from Google Fonts — the app must
	     render its own typography offline, on the first hole, with no network.

	     These are FILENAMES; the names code asks for are the PostScript names
	     (Archivo-Regular/Medium/SemiBold/Bold/ExtraBold,
	     Fraunces-Regular/SemiBold/Bold), which is why TapFont spells those and
	     `TapFontTests` asserts every one of them actually resolves. A wrong
	     entry here fails silently at runtime: UIKit simply falls back to the
	     system face and the app looks almost right. -->
	<key>UIAppFonts</key>
	<array>
		<string>Archivo-400.ttf</string>
		<string>Archivo-500.ttf</string>
		<string>Archivo-600.ttf</string>
		<string>Archivo-700.ttf</string>
		<string>Archivo-800.ttf</string>
		<string>Fraunces-400.ttf</string>
		<string>Fraunces-600.ttf</string>
		<string>Fraunces-700.ttf</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<!-- iPhone only, portrait only. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!-- Dev scheme for share links when universal links are unavailable
	     (simulator without the associated-domain association, `xcrun simctl
	     openurl`). Parsed by DeepLinkRouter alongside the https form. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.marcusandersson.tapscore.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>tapscore</string>
			</array>
		</dict>
	</array>
	<!-- The dev server runs on http://localhost:3030. Allow local networking
	     ONLY — do NOT widen this to NSAllowsArbitraryLoads. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
